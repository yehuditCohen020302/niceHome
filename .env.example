# Local server port (the client dev server proxies /api to it)
PORT=3001

# Product sources, comma separated:
#   shopify  - public catalogs of Israeli stores (see server/src/providers/shopify/stores.ts). Free.
#   serpapi  - Google Shopping via SerpApi. Needs SERPAPI_KEY below; skipped when the key is empty.
#   mock     - clearly labeled sample catalog, for UI development without internet.
PRODUCT_PROVIDERS=shopify,serpapi

# Optional: SerpApi key (https://serpapi.com). Free tier: 250 searches/month.
# Each product category is searched at most once per PRICE_TTL_MINUTES, results are cached on disk.
SERPAPI_KEY=

# Image analysis implementation. Only "mock" exists so far.
ANALYSIS_ENGINE=mock

# Visualization: OpenAI image editing. Put your key here (https://platform.openai.com/api-keys).
# With a key, the generator is used automatically; without one, the original photo is shown.
# Each design = one image edit request (paid; see OpenAI pricing). The room photo and the
# chosen products' photos are sent to OpenAI.
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium        # low | medium | high
# GENERATION_ENGINE=mock             # force "no visualization" even with a key

# How long downloaded prices are trusted before catalogs are re-downloaded (minutes)
PRICE_TTL_MINUTES=360
