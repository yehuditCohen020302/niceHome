# Local server port (the client dev server proxies /api to it)
PORT=3001

# Active product providers, comma separated. Only "mock" exists in Phase 1.
PRODUCT_PROVIDERS=mock

# Image analysis implementation. Only "mock" exists in Phase 1.
ANALYSIS_ENGINE=mock

# Image generation implementation. Only "mock" exists in Phase 1.
GENERATION_ENGINE=mock

# After how many minutes a product price is considered unverified
PRICE_TTL_MINUTES=360
